{
  "name": "@yggdrasil-forge/cli",
  "version": "1.1.0",
  "description": "Command-line tools for Yggdrasil Forge",
  "license": "MIT",
  "author": "Agarfal",
  "homepage": "https://github.com/fraga-labs/yggdrasil-forge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fraga-labs/yggdrasil-forge.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ygg": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsup --silent && node ./dist/bin.js schema --out ../../schema/yggdrasil-document.schema.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@yggdrasil-forge/core": "workspace:*",
    "@yggdrasil-forge/editor-core": "workspace:*",
    "@yggdrasil-forge/react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6",
    "@yggdrasil-forge/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}

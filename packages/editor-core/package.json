{
  "name": "@yggdrasil-forge/editor-core",
  "version": "1.0.0",
  "description": "Headless editor engine for Yggdrasil Forge — documents, commands with undo/redo, live validation, auto-layout, presets and serialization. Zero UI, zero React.",
  "license": "MIT",
  "author": "Agarfal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@yggdrasil-forge/common": "workspace:*",
    "@yggdrasil-forge/core": "workspace:*",
    "immer": "^10.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fraga-labs/yggdrasil-forge.git",
    "directory": "packages/editor-core"
  },
  "homepage": "https://fraga-labs.github.io/yggdrasil-forge/",
  "publishConfig": {
    "access": "public"
  }
}

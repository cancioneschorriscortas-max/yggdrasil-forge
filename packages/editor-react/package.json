{
  "name": "@yggdrasil-forge/editor-react",
  "version": "1.0.0",
  "description": "The Yggdrasil Forge Studio — full visual editor UI for progression trees: canvas, inspector, cards view, play mode, synchronized code panel. The application layer over @yggdrasil-forge/editor-core.",
  "license": "MIT",
  "author": "Agarfal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "@yggdrasil-forge/core": "workspace:*",
    "@yggdrasil-forge/editor-core": "workspace:*",
    "@yggdrasil-forge/react": "workspace:*",
    "dockview-react": "catalog:",
    "jsonc-parser": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jest-axe": "^10.0.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cancioneschorriscortas-max/yggdrasil-forge.git",
    "directory": "packages/editor-react"
  },
  "homepage": "https://cancioneschorriscortas-max.github.io/yggdrasil-forge/",
  "publishConfig": {
    "access": "public"
  }
}
